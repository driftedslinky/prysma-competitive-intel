[Unit]
Description=Prysma competitive intelligence web dashboard (Nebius x NVIDIA hackathon)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/prysma
EnvironmentFile=/opt/prysma/.env
ExecStart=/opt/prysma/.venv/bin/python -m prysma.web --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10
StandardOutput=append:/var/log/prysma-web.log
StandardError=append:/var/log/prysma-web.log

[Install]
WantedBy=multi-user.target