# ============================================
# PRYSMA CONFIGURATION
# ============================================

# Telegram (required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your numeric Telegram user ID. Message @userinfobot on Telegram to get it.
TELEGRAM_ALLOWED_USERS=your_numeric_telegram_id_here

# Nebius Token Factory / Nemotron (required for AI analysis)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Model tiers: Nano = fast triage, Super = mid-tier, Ultra = strategic synthesis
NEBIUS_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily (competitor news and market search)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional APIs (for enhanced monitoring)
NEWSAPI_KEY=
GITHUB_TOKEN=

# Database
DATABASE_PATH=data/prysma.db

# Scanning
SCAN_INTERVAL_HOURS=6
MAX_CONTENT_LENGTH=5000
MAX_FINDINGS_PER_DIGEST=10
# Comma-separated app store search terms for new-entrant detection
NEW_ENTRANT_KEYWORDS=round timer,boxing timer,HIIT timer,interval timer,Tabata timer,workout timer

# Trend Radar
TREND_SIGNAL_THRESHOLD=3
TREND_LOOKBACK_DAYS=30

# Security
MAX_REQUESTS_PER_MINUTE=5
